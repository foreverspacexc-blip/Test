local Auto_Parry = {
    SavedRemote = nil,
    SavedArgs = nil,
    IsReady = false
}

-- 1. ดักจับ Packet ที่ถูกต้องจากการตีเองครั้งแรก
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    -- ตรวจสอบว่าเป็นการเรียก FireServer จากตัวเกมจริง (not checkcaller)
    if not checkcaller() and method == "FireServer" then
        -- หาจุดสังเกตของ Parry Remote (เช่น มี Argument ตัวแรกเป็น UUID string ยาวๆ)
        if type(args[1]) == "string" and string.match(args[1], "%w+%-%w+%-%w+%-%w+%-%w+") and #args >= 5 then
            
            -- [!] ดักจับข้อมูลสำเร็จ
            Auto_Parry.SavedRemote = self
            
            -- คัดลอก Arguments ที่สมบูรณ์แบบ (Token, Cache, CFrame แท้) มาเก็บไว้
            Auto_Parry.SavedArgs = args
            
            if not Auto_Parry.IsReady then
                Auto_Parry.IsReady = true
                print("🎯 [Bypass Success] Captured valid remote and arguments from the first hit!")
            end
        end
    end

    return oldNamecall(self, ...)
end)

-- 2. ฟังก์ชันสำหรับยิงรีโมท (ใช้งานหลังจากตีโดนแล้ว 1 ที)
function Auto_Parry.FireParryRemote()
    if not Auto_Parry.IsReady or not Auto_Parry.SavedRemote or not Auto_Parry.SavedArgs then 
        return -- จะไม่ทำงานจนกว่าผู้เล่นจะตีบอลเองก่อน
    end

    local character = game:GetService("Players").LocalPlayer.Character
    local activeBall = Auto_Parry.Get_Ball() -- ฟังก์ชันหาลูกบอลของคุณ
    
    if character and character:FindFirstChild("HumanoidRootPart") and activeBall then
        -- (Option) คุณสามารถอัปเดตแค่ CFrame ใน SavedArgs ให้หันหน้าหาบอลปัจจุบันได้
        -- แต่ถ้าเซิร์ฟเวอร์ไม่ได้เช็ค CFrame เข้มงวด สามารถยิง args เดิมที่ดักมาได้เลย
        
        -- ใช้ข้อมูลที่ดักมาได้ ยิงกลับไปตรงๆ
        pcall(function()
            Auto_Parry.SavedRemote:FireServer(unpack(Auto_Parry.SavedArgs))
        end)
    end
end

