local cachedToken = nil
local lastTokenTick = 0
local function generateToken(currentKey)
    if not currentKey then return nil end
    if tick() - lastTokenTick < 0.01 and cachedToken then return cachedToken end
    
    -- หากตรวจไม่พบฟังก์ชันแปลงรหัส ให้ใช้ระบบคำนวณจำลองเพื่อเลี่ยงโครงสร้างพัง
    if not ZX_Parry.TransformFn then
        local serverTime = workspace:GetServerTimeNow() * 100
        return tostring(math.floor(serverTime))
    end
    
    local tok, transformed = pcall(ZX_Parry.TransformFn, currentKey, "TIME")
    if not tok or not transformed then 
        local serverTime = workspace:GetServerTimeNow() * 100
        return tostring(math.floor(serverTime))
    end
    
    local serverTime = workspace:GetServerTimeNow() * 100
    local timeStr = tostring(math.floor(serverTime))
    local tokenChars = {}
    for i = 1, #timeStr do
        local ki = (i - 1) % #transformed + 1
        tokenChars[i] = string.char(bit32.bxor((string.byte(timeStr, i) + i) % 256, string.byte(transformed, ki)))
    end
    cachedToken = table.concat(tokenChars)
    lastTokenTick = tick()
    return cachedToken
end

-- ═══ 🛡️ SAFE REMOTEFIRING SYSTEM ═══
local function fireParryRemote(ignoreCooldown)
    local curTime = tick()
    if not ignoreCooldown and (curTime - lastParryTime < parryCooldown) then return end
    
    if not ZX_Parry.Hooked then return end
    
    local currentKey = "DefaultKey"
    pcall(function()
        if type(ZX_Parry.KeyTable) == "table" then
            local keyIndex = ZX_Parry.KeyTable[3] or 1
            currentKey = ZX_Parry.KeyTable[1] and ZX_Parry.KeyTable[1][keyIndex] or ZX_Parry.KeyTable[keyIndex] or ZX_Parry.KeyTable
        else
            currentKey = ZX_Parry.KeyTable or "DefaultKey"
        end
    end)
    
    local token = generateToken(currentKey)
    
    lastParryTime = curTime
    lastHitTick = curTime
    
    local cam = workspace.CurrentCamera
    local randomMousePos = {
        (cam.ViewportSize.X / 2) + math.random(-4, 4),
        (cam.ViewportSize.Y / 2) + math.random(-4, 4)
    }
    
    local LocalPlayer = game:GetService("Players").LocalPlayer
    if not LocalPlayer or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end

    -- ทำระบบส่งข้อมูลคู่ขนาน (ส่งทั้งผ่าน NetModule และยิงตรงเข้าคลังเซิร์ฟเวอร์หลักเพื่อดักทุกทาง)
    pcall(function() 
        local targetRemote = ZX_Parry.Remote or game:GetService("ReplicatedStorage").Remotes.ParryAttempt
        targetRemote:FireServer(
            ZX_Parry.ParryHash, 
            currentKey, 
            token, 
            0.5, 
            LocalPlayer.Character.HumanoidRootPart.CFrame, 
            {}, 
            randomMousePos, 
            false
        ) 
    end)
end

