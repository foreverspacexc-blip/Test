-- ═══ 🛡️ ADVANCED NETWORK HOOK & BYPASS SYSTEM ════════════════════════════════
local hookfunction = hookfunction or (getgenv and getgenv().hookfunction)
local getgc = getgc or debug.getregistry

local controllersFolder = game:GetService("ReplicatedStorage"):WaitForChild("Controllers", 10)
local realControllerName = "SwordsController \12"

-- ดึงชื่อสุ่มจริงของโฟลเดอร์ในเซสชั่นปัจจุบัน
if controllersFolder then
    for _, child in ipairs(controllersFolder:GetChildren()) do
        if string.sub(child.Name, 1, 16) == "SwordsController" then
            realControllerName = child.Name
            break
        end
    end
end

-- [BAC Bypass] ส่งค่าจำลองหลอกระบบตรวจจับของเกม
if hookfunction and getrenv then
    pcall(function()
        local _BAC_oldDebugInfo
        _BAC_oldDebugInfo = hookfunction(getrenv().debug.info, function(f, t)
            if type(f) == "function" then return "[C]"
            elseif f == 4 and t == "s" then 
                return "ReplicatedStorage.Controllers." .. realControllerName 
            end
            return _BAC_oldDebugInfo(f, t)
        end)
    end)
end

-- ═══ ⚔️ GAME ENGINE INJECTION (ดักจับขั้วสัญญาณตรงจากหน่วยความจำเกม) ═══
local GameParryFunction = nil
local spamActive = true

-- ใช้ Garbage Collector (GC) ค้นหาฟังก์ชันแท้ของเกมที่ถูกคอมไพล์ไว้ในระบบ
if getgc then
    for _, obj in ipairs(getgc()) do
        if type(obj) == "function" and islclosure(obj) then
            local info = debug.getinfo(obj)
            -- ค้นหาฟังก์ชันที่สืบเนื่องมาจากโมดูล PRY ของเกมโดยตรง
            if info.source and (string.find(info.source, "PRY") or string.find(info.source, "SwordsController")) then
                -- ตรวจสอบโครงสร้างจำนวนอัปแวลูภายในให้ตรงกับลักษณะฟังก์ชัน v_u_29 ในไฟล์ที่ 3
                local ups = debug.getupvalues(obj)
                if #ups >= 3 then
                    GameParryFunction = obj
                    break
                end
            end
        end
    end
end

-- ระบบจัดการยิงรีโมทโดยอ้างอิงจากโครงสร้างเน็ตเวิร์กแท้
local function forceFireServer()
    if not GameParryFunction then return end
    
    pcall(function()
        local LocalPlayer = game:GetService("Players").LocalPlayer
        if not LocalPlayer or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
        
        local currentCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
        local cam = workspace.CurrentCamera
        local mousePos = {cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2}
        
        -- เรียกใช้งานฟังก์ชันยิงข้อมูลของตัวเกมโดยตรง (ตามโครงสร้างพารามิเตอร์ในไฟล์ที่ 3)
        -- บังคับส่งผ่าน Argument ลำดับที่ถูกต้อง: (CFrame, MousePos, Data_Tables)
        GameParryFunction(currentCFrame, mousePos, {}, false)
    end)
end

-- หากระบบดักจับฟังก์ชันล้มเหลว ให้ใช้แผนสำรอง (ยิงตรงผ่านรีโมทหลัก)
local BackupRemote = nil
pcall(function()
    BackupRemote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes", 5):FindFirstChild("ParryAttempt")
end)

local function fireBackupRemote()
    if not BackupRemote then return end
    pcall(function()
        local LocalPlayer = game:GetService("Players").LocalPlayer
        local currentCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
        -- พยายามส่งแพ็กเก็ตแบบคาดเดาโครงสร้างโทเค็นพื้นฐาน
        BackupRemote:FireServer("Parry", workspace:GetServerTimeNow(), currentCFrame)
    end)
end

