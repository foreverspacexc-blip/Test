local Auto_Parry = {
    SavedRemote = nil,
    IsReady = false,
    ParryTimeCache = 0.5 -- อิงจาก v_u_80 ใน Source code (ค่าเริ่มต้นปกติคือ 0.5)
}

-- ดึง Services ที่จำเป็นให้ตรงกับ SwordsController
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local LocalPlayer = Players.LocalPlayer

-- 1. ฟังก์ชันหาข้อมูลความเร็ว/ประเภทบอล
function Auto_Parry.Get_Ball()
    local bc = workspace:FindFirstChild("Balls") or workspace:FindFirstChild("TrainingBalls")
    if bc then
        for _, b in pairs(bc:GetChildren()) do
            if b:IsA("BasePart") and (b:GetAttribute("realBall") or b:GetAttribute("target")) then 
                return b 
            end
        end
    end
    return nil
end

-- 2. ฟังก์ชันจำลองตาราง Target Positions (Alive Cache) ให้เหมือนจริงตาม Source Code ทุกประการ
local function BuildExactTargetCache(cam)
    local freshCache = {}
    if not cam then return freshCache end

    local currentMode = workspace:GetAttribute("CurrentlySelectedMode")
    local myChar = LocalPlayer.Character
    local isLobbyTraining = LocalPlayer:GetAttribute("LobbyTraining") or LocalPlayer:GetAttribute("LobbyParry")

    -- กรณีเล่นโหมด Lobby Training
    if isLobbyTraining then
        local deadFolder = workspace:FindFirstChild("Dead")
        if deadFolder then
            for _, v in ipairs(deadFolder:GetChildren()) do
                local p = Players:GetPlayerFromCharacter(v)
                if p and p:GetAttribute("LobbyTraining") and v:FindFirstChild("HumanoidRootPart") then
                    freshCache[v.Name] = cam:WorldToScreenPoint(v.HumanoidRootPart.Position)
                end
            end
        end
        for _, v in ipairs(CollectionService:GetTagged("LobbyTrainingTarget")) do
            if v:IsA("BasePart") then
                freshCache[v.Name] = cam:WorldToScreenPoint(v.Position)
            end
        end

    -- กรณีเล่นโหมดฟุตบอล Hovergoal / Soccer
    elseif currentMode == "Hovergoal" or currentMode == "Soccer" then
        -- หาประตูของฝั่งตรงข้าม
        -- ตัวแปรจำลองระบบทีม (ปกติดึงจาก ThreadSafeTargetingHelper แต่เรา Hardcode เช็กชื่อประตูแทนได้)
        for _, v in ipairs(CollectionService:GetTagged("HovergoalGoal")) do
            if v:FindFirstChild("Target") then
                freshCache[v.Name] = cam:WorldToScreenPoint(v.Target.Position)
            end
        end
        -- ดึงพิกัดพวกซอมบี้ที่เกิดเพิ่มมาในโหมดนี้
        local aliveFolder = workspace:FindFirstChild("Alive")
        if aliveFolder then
            for _, v in ipairs(aliveFolder:GetChildren()) do
                if v:FindFirstChild("HumanoidRootPart") and v:GetAttribute("IsTheRisingZombie") then
                    freshCache[v.Name] = cam:WorldToScreenPoint(v.HumanoidRootPart.Position)
                end
            end
        end

    -- กรณีโหมด Normal / Rank Match ทั่วไป (ดึงจากโฟลเดอร์ Alive ปกติ)
    else
        local aliveFolder = workspace:FindFirstChild("Alive")
        if aliveFolder then
            for _, v in ipairs(aliveFolder:GetChildren()) do
                if v ~= myChar and v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
                    freshCache[v.Name] = cam:WorldToScreenPoint(v.HumanoidRootPart.Position)
                end
            end
        end
    end

    return freshCache
end

-- 3. Hook ดักจับช่องทางรีโมทที่ถูกต้องเจาะจงไปที่ ParryAttempt
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    
    if not checkcaller() and method == "FireServer" then
        -- เจาะจงบล็อกชื่อและตำแหน่งของ Remote บรรทัดที่ 462: Remotes.ParryAttempt:FireServer()
        if self.Name == "ParryAttempt" or (self.Parent and self.Parent.Name == "Remotes" and self.Name == "ParryAttempt") then
            Auto_Parry.SavedRemote = self
            if not Auto_Parry.IsReady then
                Auto_Parry.IsReady = true
                print("🎯 [Bypass Connected] Successfully hooked the real ParryAttempt Remote!")
            end
        end
    end
    return oldNamecall(self, ...)
end)

-- 4. ฟังก์ชันหลักในการจำลองการยิงแบบจำลองโครงสร้าง PRY เข้าเซิร์ฟเวอร์
function Auto_Parry.FireParryRemote()
    if not Auto_Parry.IsReady or not Auto_Parry.SavedRemote then 
        return 
    end

    local character = LocalPlayer.Character
    -- ตรวจสอบ State/Cooldown ป้องกันการยิงสแปมจนโดนแบน (อ้างอิงบรรทัดที่ 124-140)
    if character and character:GetAttribute("Stunned") then return end
    if character and character:GetAttribute("DoNotParry") then return end

    local cam = workspace.CurrentCamera
    if character and character:FindFirstChild("HumanoidRootPart") and cam then
        pcall(function()
            -- สร้างโครงสร้าง Arguments ให้เหมือนกับโครงสร้างฟังก์ชัน PRY ตัวจริงใน Module 
            -- อ้างอิงจากบรรทัดที่ 265: v_u_29(v_u_80, v_u_32.CFrame, v89, v99, p75)
            
            -- Argument 1: ParryTime (คำนวณตามจำนวนการสกัดกั้น หรือใช้ค่า Base 0.5)
            local parryTime = Auto_Parry.ParryTimeCache
            local serverParryCount = character:GetAttribute("ServerParryCount") or 0
            if serverParryCount == 0 then parryTime = 1.5
            elseif serverParryCount == 1 then parryTime = 1.25
            elseif serverParryCount == 2 then parryTime = 1.0
            end
            
            -- Argument 2: Camera CFrame (ตัวเก่าคุณใช้ lookAt ตัวละครซึ่งผิด!)
            local cameraCFrame = cam.CFrame
            
            -- Argument 3: Target Positions Table (ตารางพิกัดผู้เล่นอื่นแบบอัปเดตเรียลไทม์)
            local targetPositions = BuildExactTargetCache(cam)
            
            -- Argument 4: Mouse Position (ใช้พิกัดป้อนเข้าจากหน้าจอจริงของระบบ)
            local mouseLoc = UserInputService:GetMouseLocation()
            local mousePosition = { mouseLoc.X, mouseLoc.Y }
            
            -- Argument 5: Special Flag (ค่า p75 จากอีเวนต์การกดบล็อก โดยทั่วไปส่งค่า false หรือ nil ได้)
            local specialFlag = false 

            -- จัดเตรียม Packets เพื่อยิงเข้าเซิร์ฟเวอร์ตรงๆ ผ่านตัวแปรที่ดักจับได้
            Auto_Parry.SavedRemote:FireServer(
                parryTime,
                cameraCFrame,
                targetPositions,
                mousePosition,
                specialFlag
            )
        end)
    end
end

-- 5. สั่งรันลูปสำหรับการคลิกโจมตีอัตโนมัติ (สอดคล้องตามเงื่อนไขเซิร์ฟเวอร์)
task.spawn(function()
    while task.wait(0.05) do
        if Auto_Parry.IsReady then
            Auto_Parry.FireParryRemote()
        end
    end
end)
