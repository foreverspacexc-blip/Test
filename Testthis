local Auto_Parry = {
    SavedRemote = nil,
    SavedArgs = nil,
    IsReady = false
}

-- 1. ฟังก์ชันหาบอล (ยกมาจากโค้ดเก่าของคุณ)
function Auto_Parry.Get_Ball()
    local bc = workspace:FindFirstChild("Balls") or workspace:FindFirstChild("TrainingBalls")
    if bc then
        for _, b in pairs(bc:GetChildren()) do
            if b:IsA("BasePart") and (b:GetAttribute("realBall") or b:GetAttribute("target")) then 
                return b 
            end
        end
    end
    return nil
end

-- 2. Hook ดักจับ Packet ตอนตีเองครั้งแรก
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if not checkcaller() and method == "FireServer" then
        if type(args[1]) == "string" and string.match(args[1], "%w+%-%w+%-%w+%-%w+%-%w+") and #args >= 5 then
            Auto_Parry.SavedRemote = self
            Auto_Parry.SavedArgs = args
            
            if not Auto_Parry.IsReady then
                Auto_Parry.IsReady = true
                print("🎯 [Bypass Success] Captured valid remote and arguments from the first hit!")
            end
        end
    end

    return oldNamecall(self, ...)
end)

local function BuildFreshAliveCache(cam)
    local freshCache = {}
    local aliveFolder = workspace:FindFirstChild("Alive")
    local myChar = game:GetService("Players").LocalPlayer.Character
    
    if aliveFolder and cam then
        -- ลูปหาทุกคนที่ยังมีชีวิตอยู่เหมือนที่ SwordsController ทำ
        for _, v in ipairs(aliveFolder:GetChildren()) do
            if v ~= myChar and v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
                -- แปลงตำแหน่ง 3D เป็นพิกัดหน้าจอ 2D (Vector3)
                local screenPos = cam:WorldToScreenPoint(v.HumanoidRootPart.Position)
                
                -- ใช้ชื่อตัวละครเป็น Key ในการเก็บข้อมูล ตามแบบ Source Code ตัวจริง
                -- (หากเกมใช้ UUID สามารถเปลี่ยนเป็น v:GetAttribute("UUID") ได้)
                freshCache[v.Name] = screenPos
            end
        end
    end
    return freshCache
end

-- 3. ฟังก์ชันสำหรับยิงรีโมท (ใช้งานหลังจากตีโดนแล้ว 1 ที)
function Auto_Parry.FireParryRemote()
    if not Auto_Parry.IsReady or not Auto_Parry.SavedRemote or not Auto_Parry.SavedArgs then 
        return 
    end

    local character = game:GetService("Players").LocalPlayer.Character
    local activeBall = Auto_Parry.Get_Ball()
    local cam = workspace.CurrentCamera
    
    if character and character:FindFirstChild("HumanoidRootPart") and activeBall and cam then
        pcall(function()
            -- คัดลอกตาราง Args ออกมาเพื่อไม่ให้กวนของเดิม
            local currentArgs = {}
            for i, v in ipairs(Auto_Parry.SavedArgs) do
                currentArgs[i] = v
            end
            
            -- [1] สอดไส้ CFrame ปัจจุบัน (ปกติอยู่ตำแหน่งที่ 5)
            if currentArgs[5] then
                local targetPos = activeBall.Position
                currentArgs[5] = CFrame.lookAt(character.HumanoidRootPart.Position, targetPos)
            end
            
            -- [2] สอดไส้ Alive Cache ใหม่ล่าสุด (ปกติอยู่ตำแหน่งที่ 6)
            if currentArgs[6] and type(currentArgs[6]) == "table" then
                currentArgs[6] = BuildFreshAliveCache(cam)
            end
            
            -- [3] สอดไส้ตำแหน่ง Mouse ให้สมจริง (ปกติอยู่ตำแหน่งที่ 7)
            if currentArgs[7] then
                -- สุ่มขยับเมาส์นิดหน่อยรอบๆ กึ่งกลางจอ ให้ดูเหมือนคนเล่นจริง
                currentArgs[7] = { 
                    (cam.ViewportSize.X / 2) + math.random(-15, 15), 
                    (cam.ViewportSize.Y / 2) + math.random(-15, 15) 
                }
            end

            -- ยิงแพ็กเก็ตที่อัปเดตข้อมูลให้เป็นปัจจุบันแล้ว
            local safeUnpack = unpack or table.unpack
            Auto_Parry.SavedRemote:FireServer(safeUnpack(currentArgs))
        end)
    end
end

task.spawn(function()
    while task.wait(0.05) do
        Auto_Parry.FireParryRemote()
    end
end)
