if hookfunction and getrenv then
    pcall(function()
        -- Spoof debug.info to hide the execution context
        local _BAC_oldDebugInfo
        _BAC_oldDebugInfo = hookfunction(getrenv().debug.info, function(f, t)
            if type(f) == "function" then 
                return "[C]"
            -- แก้ไขตรงนี้: จากเดิมที่ตรวจชื่อเต็ม เปลี่ยนเป็นตรวจจับคำว่า "SwordsController" ในข้อความแทน
            elseif f == 4 and t == "s" then 
